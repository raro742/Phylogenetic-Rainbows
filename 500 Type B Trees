    divtime_list.append(calc_divtime(list_of_six_organisms[2], list_of_six_organisms[3]))
    divtime_list.append(calc_divtime(list_of_six_organisms[2], list_of_six_organisms[4]))
    divtime_list.append(calc_divtime(list_of_six_organisms[2], list_of_six_organisms[5]))
    divtime_list.append(calc_divtime(list_of_six_organisms[3], list_of_six_organisms[4]))
    divtime_list.append(calc_divtime(list_of_six_organisms[3], list_of_six_organisms[5]))
    divtime_list.append(calc_divtime(list_of_six_organisms[4], list_of_six_organisms[5]))
    divtime_list.sort()
    from collections import Counter
    frequency_order = Counter(divtime_list).most_common()
    five_defining_ratios=[frequency_order[0][1], frequency_order[1][1], frequency_order[2][1], frequency_order[3][1], frequency_order[4][1]]
    if five_defining_ratios==[6,5,2,1,1]:
        return True
    else:
        return False

